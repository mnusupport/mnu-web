# Public API origin used by the browser (baked in at BUILD time — rebuild the
# web app whenever this changes). It is public by design: never put secrets in
# any NEXT_PUBLIC_* variable.
# Development:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production: the deployed HTTPS API origin, e.g. https://api.<your-domain>
# (the production build FAILS if this is unset).
